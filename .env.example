# Copy this file to .env.local and fill in your own values.
# Never commit real secrets.

# Your personal Intervals.icu API key (Settings -> Developer Settings on intervals.icu).
INTERVALS_API_KEY=

# Your Intervals.icu athlete id. Defaults to "0" (the authenticated athlete) if omitted.
INTERVALS_ATHLETE_ID=0

# WorkOS AuthKit domain acting as the OAuth Authorization Server for /api/mcp.
WORKOS_AUTHKIT_DOMAIN=

# The MCP resource identifier (RFC 8707) for this server, e.g.
# https://running-coach-mcp.vercel.app/api/mcp. Must exactly match the
# Resource Indicator configured in WorkOS, and the "audience" access
# tokens are issued for.
MCP_RESOURCE_URL=

# The single WorkOS user id ("sub" claim, starts with "user_") allowed to
# use this personal MCP server. Leave unset to deny everyone (fail closed).
MCP_ALLOWED_USER_ID=

# IANA timezone used to compute the athlete's local calendar-day
# boundaries (get_recent_runs / get_wellness / get_running_progress date
# windows). Defaults to "Europe/Stockholm" if unset. Invalid values fail
# clearly rather than silently falling back to UTC.
ATHLETE_TIME_ZONE=Europe/Stockholm
